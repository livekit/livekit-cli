# Under --user-auth the number commands call the Public API. It buys and
# releases one number at a time, so lk makes one call for each.
respond GET http://publicapi.test/v0/projects/p_1/phone-numbers:search 200 '{"items":[{"e164Format":"+14155550100","countryCode":"US","areaCode":"415","numberType":"PHONE_NUMBER_TYPE_LOCAL"}],"pageInfo":{}}'
exec lk --user-auth number search --country-code US --area-code 415
stdout '\+14155550100.*US.*415.*LOCAL'

respond POST http://publicapi.test/v0/projects/p_1/phone-numbers 200 '{"phoneNumber":{"id":"PN_1","e164Format":"+14155550100","status":"PHONE_NUMBER_STATUS_ACTIVE"}}'
exec lk --user-auth number purchase --numbers +14155550100 --numbers +14155550101
stdout '^Successfully purchased 2 phone numbers:$'

respond GET http://publicapi.test/v0/projects/p_1/phone-numbers/+14155550100 200 '{"phoneNumber":{"id":"PN_1","e164Format":"+14155550100","status":"PHONE_NUMBER_STATUS_ACTIVE"}}'
exec lk --user-auth number get --number +14155550100
stdout '^  ID: PN_1$'

respond PATCH http://publicapi.test/v0/projects/p_1/phone-numbers/PN_1 200 '{"phoneNumber":{"id":"PN_1","name":"front desk","e164Format":"+14155550100","sipDispatchRuleIds":["SDR_1"]}}'
exec lk --user-auth number update --id PN_1 --name 'front desk' --sip-dispatch-rule-id SDR_1
stdout '^  SIP Dispatch Rules: SDR_1$'

respond DELETE http://publicapi.test/v0/projects/p_1/phone-numbers/PN_1 200 '{}'
respond DELETE http://publicapi.test/v0/projects/p_1/phone-numbers/PN_2 404 '{"code":5,"message":"phone number not found"}'
! exec lk --user-auth number release --ids PN_1 --ids PN_2 --ids PN_3
stderr 'released PN_1, then PN_2 failed: phone number not found'

requests
cmp stdout want-requests

-- home/.livekit/cli-config.yaml --
default_user: u_1
users:
  - id: u_1
    email: dev@example.com
    session_token: st_1
    api_url: http://publicapi.test
    projects:
      - project_id: p_1
        name: one
        alias: one
        url: ws://one.test
-- want-requests --
GET http://publicapi.test/v0/projects/p_1/phone-numbers:search bearer=st_1 project=p_1
GET http://publicapi.test/v0/projects/p_1/phone-numbers:search bearer=st_1 project=p_1
POST http://publicapi.test/v0/projects/p_1/phone-numbers bearer=st_1 project=p_1
POST http://publicapi.test/v0/projects/p_1/phone-numbers bearer=st_1 project=p_1
GET http://publicapi.test/v0/projects/p_1/phone-numbers/+14155550100 bearer=st_1 project=p_1
PATCH http://publicapi.test/v0/projects/p_1/phone-numbers/PN_1 bearer=st_1 project=p_1
DELETE http://publicapi.test/v0/projects/p_1/phone-numbers/PN_1 bearer=st_1 project=p_1
DELETE http://publicapi.test/v0/projects/p_1/phone-numbers/PN_2 bearer=st_1 project=p_1
