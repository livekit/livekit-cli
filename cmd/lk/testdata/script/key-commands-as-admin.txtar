# A project ADMIN lists, creates and deletes the project's API keys.
respond GET http://publicapi.test/v0/projects/p_1/keys 200 '{"keys":[{"apiKey":"APIold","description":"ci"}]}'
exec lk --user-auth project key list --project one
cmp stdout want-list-stdout

respond POST http://publicapi.test/v0/projects/p_1/keys 200 '{"apiKey":"APInew","secret":"secretnew"}'
exec lk --user-auth project key create --project one
cmp stdout want-create-stdout

respond DELETE http://publicapi.test/v0/projects/p_1/keys/APIold 200 '{}'
exec lk --user-auth project key delete APIold --project one
stderr 'Revoked API key APIold'

requests
cmp stdout want-requests

-- home/.livekit/cli-config.yaml --
default_user: u_admin
users:
  - id: u_admin
    email: admin@example.com
    session_token: st_admin
    api_url: http://publicapi.test
    projects:
      - project_id: p_1
        name: one
        alias: one
-- want-list-stdout --
┌─────────┬─────────────┬───────────────────┬─────────┐
│ API Key │ Description │ Owner             │ Created │
├─────────┼─────────────┼───────────────────┼─────────┤
│ APIold  │ ci          │ (service account) │ -       │
└─────────┴─────────────┴───────────────────┴─────────┘
-- want-create-stdout --
API Key:    APInew
API Secret: secretnew
-- want-requests --
GET http://publicapi.test/v0/projects/p_1/keys bearer=st_admin project=p_1
POST http://publicapi.test/v0/projects/p_1/keys bearer=st_admin project=p_1
DELETE http://publicapi.test/v0/projects/p_1/keys/APIold bearer=st_admin project=p_1
