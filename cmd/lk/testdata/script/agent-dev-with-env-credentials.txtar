# lk agent dev and lk agent start with --dev and a full set of LIVEKIT_*
# credentials are an error naming what to remove, as for other commands. The
# agent never starts with those credentials in place of the dev ones.
env LIVEKIT_URL=ws://env.test
env LIVEKIT_API_KEY=APIenv
env LIVEKIT_API_SECRET=secretenv

! exec lk agent dev --dev
stderr '^--dev can''t be combined with API key credentials; unset LIVEKIT_API_KEY and LIVEKIT_API_SECRET or drop --dev$'

! exec lk agent start --dev
stderr '^--dev can''t be combined with API key credentials; unset LIVEKIT_API_KEY and LIVEKIT_API_SECRET or drop --dev$'

env LIVEKIT_URL=
env LIVEKIT_API_KEY=
env LIVEKIT_API_SECRET=
! exec lk agent start --dev --url ws://flag.test --api-key APIflag --api-secret secretflag
stderr '^--dev can''t be combined with API key credentials; remove --api-key and --api-secret or drop --dev$'

requests
! stdout .

-- package.json --
{"name":"agent","dependencies":{"@livekit/agents":"1.6.0"}}
-- src/main.js --
