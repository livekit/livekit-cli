# A session the Public API already rejects is dead, so --revoke still signs
# the user out on this device and succeeds. The 401 body is the one the
# Public API's auth middleware sends.
respond DELETE http://publicapi.test/v0/users/me/session-token 401 '{"code":16,"message":"authentication required","details":[]}'
exec lk --user-auth cloud auth --revoke
! stdout .
cmpenv stderr want-stderr
requests
cmp stdout want-requests
cmp home/.livekit/cli-config.yaml want-config

-- home/.livekit/cli-config.yaml --
default_user: u_1
users:
  - id: u_1
    email: dev@example.com
    session_token: st_revoked
    api_url: http://publicapi.test
-- want-stderr --
Using user [dev@example.com] on [http://publicapi.test]
Session for dev@example.com was already revoked; signed out on this device
Saved CLI config to [$WORK/home/.livekit/cli-config.yaml]
-- want-requests --
DELETE http://publicapi.test/v0/users/me/session-token bearer=st_revoked
-- want-config --
default_project: ""
default_user: ""
projects: []
users: []
device_name: ""
theme: ""
