# Under --user-auth the dispatch rule commands call the Public API, and a
# request file with the proto's own field names still creates a rule.
respond POST http://publicapi.test/v0/projects/p_1/sip/dispatch-rules 200 '{"dispatchRule":{"sipDispatchRuleId":"SDR_1","name":"support"}}'
exec lk --user-auth sip dispatch create rule.json
stdout '^SIPDispatchRuleID: SDR_1$'

respond GET http://publicapi.test/v0/projects/p_1/sip/dispatch-rules 200 '{"items":[{"sipDispatchRuleId":"SDR_1","name":"support","trunkIds":["PN_1"],"rule":{"dispatchRuleIndividual":{"roomPrefix":"call-"}}}],"pageInfo":{}}'
exec lk --user-auth sip dispatch list
stdout 'SDR_1.*support.*PN_1.*Individual \(Caller\).*call-_<caller>_<random>'

respond PATCH http://publicapi.test/v0/projects/p_1/sip/dispatch-rules/SDR_1 200 '{"dispatchRule":{"sipDispatchRuleId":"SDR_1"}}'
exec lk --user-auth sip dispatch update --id SDR_1 --trunks PN_2
stdout '^SIPDispatchRuleID: SDR_1$'

respond DELETE http://publicapi.test/v0/projects/p_1/sip/dispatch-rules/SDR_1 200 '{}'
exec lk --user-auth sip dispatch delete SDR_1
stdout '^SIPDispatchRuleID: SDR_1$'

requests
cmp stdout want-requests

-- rule.json --
{"dispatch_rule": {"name": "support", "trunk_ids": ["PN_1"], "rule": {"dispatch_rule_individual": {"room_prefix": "call-"}}}}
-- home/.livekit/cli-config.yaml --
default_user: u_1
users:
  - id: u_1
    email: dev@example.com
    session_token: st_1
    api_url: http://publicapi.test
    projects:
      - project_id: p_1
        name: one
        alias: one
        url: ws://one.test
-- want-requests --
POST http://publicapi.test/v0/projects/p_1/sip/dispatch-rules bearer=st_1 project=p_1
GET http://publicapi.test/v0/projects/p_1/sip/dispatch-rules bearer=st_1 project=p_1
PATCH http://publicapi.test/v0/projects/p_1/sip/dispatch-rules/SDR_1 bearer=st_1 project=p_1
DELETE http://publicapi.test/v0/projects/p_1/sip/dispatch-rules/SDR_1 bearer=st_1 project=p_1
