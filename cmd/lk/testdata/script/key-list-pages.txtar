# A key list longer than a page shows every key: lk passes each page's
# cursor back until the Public API says there are no more.
respond GET http://publicapi.test/v0/projects/p_1/keys?includeAgentKeys=false 200 '{"items":[{"apiKey":"APIone","description":"first page"}],"pageInfo":{"nextCursor":"c1","hasMore":true}}'
respond GET http://publicapi.test/v0/projects/p_1/keys?includeAgentKeys=false&page.cursor=c1 200 '{"items":[{"apiKey":"APItwo","description":"second page"}],"pageInfo":{"nextCursor":"","hasMore":false}}'
exec lk --user-auth project key list --project one
cmp stdout want-list-stdout

requests
cmp stdout want-requests

-- home/.livekit/cli-config.yaml --
default_user: u_admin
users:
  - id: u_admin
    email: admin@example.com
    session_token: st_admin
    api_url: http://publicapi.test
    projects:
      - project_id: p_1
        name: one
        alias: one
-- want-list-stdout --
┌─────────┬─────────────┬───────────────────┬─────────┐
│ API Key │ Description │ Owner             │ Created │
├─────────┼─────────────┼───────────────────┼─────────┤
│ APIone  │ first page  │ (service account) │ -       │
│ APItwo  │ second page │ (service account) │ -       │
└─────────┴─────────────┴───────────────────┴─────────┘
-- want-requests --
GET http://publicapi.test/v0/projects/p_1/keys bearer=st_admin project=p_1
GET http://publicapi.test/v0/projects/p_1/keys bearer=st_admin project=p_1
