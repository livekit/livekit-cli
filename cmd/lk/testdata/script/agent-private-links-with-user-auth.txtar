POST http://agents.test/twirp/livekit.CloudAgent/CreatePrivateLink apikey=APIone
POST http://agents.test/twirp/livekit.CloudAgent/ListPrivateLinks apikey=APIone
POST http://agents.test/twirp/livekit.CloudAgent/GetPrivateLinkStatus apikey=APIone
POST http://agents.test/twirp/livekit.CloudAgent/GetPrivateLinkStatus apikey=APIone
POST http://agents.test/twirp/livekit.CloudAgent/DestroyPrivateLink apikey=APIone
GET http://publicapi.test/v0/projects/p_1/agent-client-settings bearer=st_1 project=p_1
POST http://publicapi.test/v0/projects/p_1/private-links bearer=st_1 project=p_1
GET http://publicapi.test/v0/projects/p_1/private-links bearer=st_1 project=p_1
GET http://publicapi.test/v0/projects/p_1/private-links/PL_1/status bearer=st_1 project=p_1
