├──────┼──────┼─────────┼──────────────┼──────┼─────────────────────────────────────────┼─────────────────────┼─────────┼──────────────────────┼────────┤
│ PL_1 │ db   │ us-east │ us-east-1    │ 5432 │ com.amazonaws.vpce.us-east-1.vpce-svc-1 │ db.pl.livekit.cloud │ Healthy │ 2026-11-23T10:00:00Z │ -      │
└──────┴──────┴─────────┴──────────────┴──────┴─────────────────────────────────────────┴─────────────────────┴─────────┴──────────────────────┴────────┘
