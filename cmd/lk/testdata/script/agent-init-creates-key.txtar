# Under user auth, lk agent init creates a new service-account key on every
# run, and writes it into the new agent's env file.
skip 'known bug: agent init fetches the template index from GitHub even with --template-url, so it can''t run offline (no ticket yet)'

exec git -C template init -q
exec git -C template add .
exec git -C template -c user.name=lk -c user.email=lk@example.com commit -q -m template

respond POST http://publicapi.test/v0/projects/p_1/keys 200 '{"apiKey":"APInew","secret":"secretnew"}'

exec lk --user-auth agent init first --project one --template-url $WORK/template --install=false --skills=false
grep 'LIVEKIT_API_KEY="APInew"' first/.env.local
exec lk --user-auth agent init second --project one --template-url $WORK/template --install=false --skills=false
grep 'LIVEKIT_API_KEY="APInew"' second/.env.local

requests
cmp stdout want-requests

-- template/.env.example --
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
-- home/.livekit/cli-config.yaml --
default_user: u_admin
users:
  - id: u_admin
    email: admin@example.com
    session_token: st_admin
    api_url: http://publicapi.test
    projects:
      - project_id: p_1
        name: one
        alias: one
        url: ws://one.test
-- want-requests --
POST http://publicapi.test/v0/projects/p_1/keys bearer=st_admin project=p_1
POST http://publicapi.test/v0/projects/p_1/keys bearer=st_admin project=p_1
