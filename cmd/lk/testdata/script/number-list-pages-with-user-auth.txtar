# Under --user-auth, number list prints one page, and the cursor of the next
# page in place of an offset. --offset is for API keys only.
respond GET 'http://publicapi.test/v0/projects/p_1/phone-numbers?page.pageSize=1' 200 '{"items":[{"id":"PN_2","e164Format":"+14155550101","status":"PHONE_NUMBER_STATUS_ACTIVE"}],"pageInfo":{"nextCursor":"c2","hasMore":true}}'
exec lk --user-auth number list --limit 1
stdout 'PN_2.*\+14155550101.*ACTIVE'
stderr '^More results available. Use --cursor c2 to see the next page.$'

respond GET 'http://publicapi.test/v0/projects/p_1/phone-numbers?page.cursor=c2&page.pageSize=1' 200 '{"items":[{"id":"PN_1","e164Format":"+14155550100","status":"PHONE_NUMBER_STATUS_ACTIVE"}],"pageInfo":{"hasMore":false}}'
exec lk --user-auth number list --limit 1 --cursor c2
stdout 'PN_1.*\+14155550100'
! stderr 'More results'

! exec lk --user-auth number list --offset 5
stderr '^--offset is not supported with --user-auth'

requests
cmp stdout want-requests

-- home/.livekit/cli-config.yaml --
default_user: u_1
users:
  - id: u_1
    email: dev@example.com
    session_token: st_1
    api_url: http://publicapi.test
    projects:
      - project_id: p_1
        name: one
        alias: one
        url: ws://one.test
-- want-requests --
GET http://publicapi.test/v0/projects/p_1/phone-numbers bearer=st_1 project=p_1
GET http://publicapi.test/v0/projects/p_1/phone-numbers bearer=st_1 project=p_1
