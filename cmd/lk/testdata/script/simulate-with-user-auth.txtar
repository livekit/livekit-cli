# Under --user-auth, simulation calls carry a token the Public API creates
# for the session, not an API key, and the hint to follow the run keeps
# --user-auth so it runs as the same user.
mint st_1
respond POST http://sim.test/twirp/livekit.AgentSimulation/GetSimulationRun 200 ''

! exec lk --user-auth agent simulate export SR_1 --server-url http://sim.test
! stdout .
stderr '^simulation run SR_1 is still in progress \(.*\); follow it with lk agent simulate view SR_1 --project one --user-auth --server-url http://sim.test$'

requests
cmp stdout want-requests

-- home/.livekit/cli-config.yaml --
default_user: u_1
users:
  - id: u_1
    email: dev@example.com
    session_token: st_1
    api_url: http://publicapi.test
    projects:
      - project_id: p_1
        name: one
        alias: one
        url: ws://one.test
-- want-requests --
POST http://publicapi.test/v0/projects/p_1/tokens bearer=st_1 project=p_1
POST http://sim.test/twirp/livekit.AgentSimulation/GetSimulationRun apikey=APImint_p_1
