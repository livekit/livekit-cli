# Under --user-auth, lk agent versions, secrets, dockerfile and logs
# --log-type build read through the Public API's AgentService, so they print
# what they print with an API key for the same data. They ask for no token:
# here the Public API would refuse one, as it refuses a member below admin.
# Only a runtime log still goes through the token bridge.
env LK_AGENTS_URL=http://agents.test
respond POST http://publicapi.test/v0/projects/p_1/tokens 403 '{"code":7,"message":"this needs ADMIN on the project"}'

# Versions. The Public API leaves out the deploy time of a version that was
# never deployed, where cloud agents lists the zero time.
respond POST http://agents.test/twirp/livekit.CloudAgent/ListAgentVersions 200 '{"versions":[{"version":"v20261121","createdAt":"2026-11-21T09:00:00Z","deployedAt":"0001-01-01T00:00:00Z","status":"Failed"},{"version":"v20261120","current":true,"active":true,"createdAt":"2026-11-20T09:00:00Z","deployedAt":"2026-11-20T10:00:00Z","attributes":{"git_sha":"abc123"},"status":"Succeeded"}]}'
respond GET http://publicapi.test/v0/projects/p_1/agents/CA_1/versions 200 '{"items":[{"version":"v20261121","createdAt":"2026-11-21T09:00:00Z","status":"Failed"},{"version":"v20261120","current":true,"active":true,"createdAt":"2026-11-20T09:00:00Z","deployedAt":"2026-11-20T10:00:00Z","attributes":{"git_sha":"abc123"},"status":"Succeeded"}],"pageInfo":{}}'
exec lk agent versions --id CA_1
cmp stdout want-versions
exec lk --user-auth agent versions --id CA_1
cmp stdout want-versions
# protojson varies its spacing from build to build, so --json output is
# checked against the other mode's, from the same build.
exec lk agent versions --id CA_1 --json
stdout '"deployedAt":\s+"0001-01-01T00:00:00Z"'
cp stdout versions-api-key.json
exec lk --user-auth agent versions --id CA_1 --json
cmp stdout versions-api-key.json

# Secret names. lk hides the LIVEKIT_ secrets in both modes.
respond POST http://agents.test/twirp/livekit.CloudAgent/ListAgentSecrets 200 '{"secrets":[{"name":"API_TOKEN","createdAt":"2026-11-01T00:00:00Z","updatedAt":"2026-11-02T00:00:00Z","kind":"AGENT_SECRET_KIND_ENVIRONMENT"},{"name":"LIVEKIT_URL","createdAt":"2026-11-01T00:00:00Z","updatedAt":"2026-11-01T00:00:00Z"}]}'
respond GET http://publicapi.test/v0/projects/p_1/agents/CA_1/secrets 200 '{"items":[{"name":"API_TOKEN","createdAt":"2026-11-01T00:00:00Z","updatedAt":"2026-11-02T00:00:00Z","kind":"AGENT_SECRET_KIND_ENVIRONMENT"},{"name":"LIVEKIT_URL","createdAt":"2026-11-01T00:00:00Z","updatedAt":"2026-11-01T00:00:00Z"}],"pageInfo":{}}'
exec lk agent secrets --id CA_1
cmp stdout want-secrets
exec lk --user-auth agent secrets --id CA_1
cmp stdout want-secrets
exec lk agent secrets --id CA_1 --json
! stdout LIVEKIT_URL
cp stdout secrets-api-key.json
exec lk --user-auth agent secrets --id CA_1 --json
cmp stdout secrets-api-key.json

# The client settings that lk agent dockerfile reads, as create and deploy do.
respond POST http://agents.test/twirp/livekit.CloudAgent/GetClientSettings 200 '{"params":[{"name":"available_regions","value":"us-east,eu-central"}]}'
respond GET http://publicapi.test/v0/projects/p_1/agent-client-settings 200 '{"params":[{"name":"available_regions","value":"us-east,eu-central"}]}'
cd api-key
exec lk agent dockerfile
cd ../user-auth
exec lk --user-auth agent dockerfile
cd ..
cmp api-key/Dockerfile user-auth/Dockerfile
cmp api-key/.dockerignore user-auth/.dockerignore

# The build log of the version that a deployment runs. With an API key, cloud
# agents finds the version; under --user-auth, lk finds it in the agent.
respond POST http://agents.test/twirp/livekit.CloudAgent/ListAgents 200 '{"agents":[{"agentId":"CA_1","version":"v20261120","agentDeployments":[{"region":"us-east","serverRegion":"osbxash1a","version":"v20261120"},{"region":"us-east","serverRegion":"osbxash1a","deployment":"staging","version":"v20261121"}]}]}'
respond GET http://publicapi.test/v0/projects/p_1/agents/CA_1 200 '{"agent":{"info":{"agentId":"CA_1","version":"v20261120","agentDeployments":[{"region":"us-east","serverRegion":"osbxash1a","version":"v20261120"},{"region":"us-east","serverRegion":"osbxash1a","deployment":"staging","version":"v20261121"}]},"status":"DEPLOYMENT_STATUS_RUNNING"}}'
respond GET http://agents.test/logs 200 '#2 DONE 0.1s'
respond GET http://publicapi.test/v0/projects/p_1/agents/CA_1/versions/v20261120/build-log 200 '{"text":"#2 DONE 0.1s\n"}'
respond GET http://publicapi.test/v0/projects/p_1/agents/CA_1/versions/v20261121/build-log 200 '{"text":"#2 DONE 0.1s"}'
exec lk agent logs --id CA_1 --log-type build
cmp stdout want-build-log
exec lk --user-auth agent logs --id CA_1 --log-type build
cmp stdout want-build-log
! stderr 'too long'
exec lk --user-auth agent logs --id CA_1 --log-type build --deployment staging
cmp stdout want-build-log

# A log longer than the Public API returns comes back as its end, and lk
# says so.
respond GET http://publicapi.test/v0/projects/p_1/agents/CA_1/versions/v20261120/build-log 200 '{"text":"#2 DONE 0.1s\n","truncated":true}'
exec lk --user-auth agent logs --id CA_1 --log-type build
cmp stdout want-build-log
stderr '^The build log of version v20261120 is too long to show in full: this is its end\.$'

# A build that hasn't ended has no log yet, and a deployment that runs no
# version has none to read.
respond GET http://publicapi.test/v0/projects/p_1/agents/CA_1/versions/v20261120/build-log 404 '{"code":5,"message":"build log not found"}'
! exec lk --user-auth agent logs --id CA_1 --log-type build
stderr '^build log not found$'
! exec lk --user-auth agent logs --id CA_1 --log-type build --deployment canary
stderr '^no version deployed to the canary deployment of agent CA_1$'

# A runtime log still streams through the token bridge, which needs a
# project admin.
! exec lk --user-auth agent logs --id CA_1
stderr '^signed in with --user-auth, this command needs a project admin \(this needs ADMIN on the project\)\. A project API key works meanwhile: re-run without --user-auth$'

requests
cmp stdout want-requests

-- api-key/requirements.txt --
livekit-agents
-- api-key/agent.py --
-- user-auth/requirements.txt --
livekit-agents
-- user-auth/agent.py --
-- home/.livekit/cli-config.yaml --
default_project: one
projects:
  - name: one
    project_id: p_1
    url: ws://one.test
    api_key: APIone
    api_secret: secretone
default_user: u_1
users:
  - id: u_1
    email: dev@example.com
    session_token: st_1
    api_url: http://publicapi.test
    projects:
      - project_id: p_1
        name: one
        alias: one
        url: ws://one.test
-- want-versions --
