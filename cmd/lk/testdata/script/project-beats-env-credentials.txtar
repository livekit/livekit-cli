# --project wins over credentials in the environment: the request goes to the
# named project's server, with a token issued by that project's key.
env LIVEKIT_URL=ws://env.test
env LIVEKIT_API_KEY=APIenv
env LIVEKIT_API_SECRET=secretenv
respond POST http://one.test/twirp/livekit.RoomService/ListRooms 200 ''
respond POST http://env.test/twirp/livekit.RoomService/ListRooms 200 ''

exec lk --project one room list
requests
cmp stdout want-requests

-- home/.livekit/cli-config.yaml --
projects:
  - name: one
    project_id: p_1
    url: ws://one.test
    api_key: APIone
    api_secret: secretone
-- want-requests --
POST http://one.test/twirp/livekit.RoomService/ListRooms apikey=APIone
