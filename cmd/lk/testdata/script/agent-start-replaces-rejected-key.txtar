# A key in .env.local that LiveKit rejects (deleted from the project) is
# reported and skipped before the agent starts, and the key lk creates in its
# place replaces it in .env.local, keeping the file's other settings.
[!exec:node] skip 'needs node to run the agent'
respond POST http://one.test/twirp/livekit.RoomService/ListRooms 401 ''
respond POST http://publicapi.test/v0/projects/p_1/keys 200 '{"apiKey":"APInew","secret":"secretnew"}'

exec lk --user-auth agent start
stdout '^agent ws://one.test APInew secretnew$'
stderr '^LiveKit rejected API key \[APIgone\] from .*/\.env\.local \(deleted, or for another project\); not using it$'
grep '^LIVEKIT_API_KEY="APInew"$' .env.local
grep '^OPENAI_API_KEY=sk-test$' .env.local
! grep APIgone .env.local

requests
cmp stdout want-requests

-- home/.livekit/cli-config.yaml --
default_user: u_1
users:
  - id: u_1
    email: dev@example.com
    session_token: st_1
    api_url: http://publicapi.test
    projects:
      - project_id: p_1
        name: one
        alias: one
        url: ws://one.test
-- .env.local --
OPENAI_API_KEY=sk-test
LIVEKIT_URL=ws://one.test
LIVEKIT_API_KEY=APIgone
LIVEKIT_API_SECRET=secretgone
-- package.json --
{"name":"agent","main":"src/main.js","dependencies":{"@livekit/agents":"1.6.0"}}
-- src/main.js --
console.log('agent', process.env.LIVEKIT_URL, process.env.LIVEKIT_API_KEY, process.env.LIVEKIT_API_SECRET);
-- node_modules/@livekit/agents/package.json --
{"name":"@livekit/agents","version":"1.6.0","main":"index.js"}
-- node_modules/@livekit/agents/index.js --
-- want-requests --
POST http://one.test/twirp/livekit.RoomService/ListRooms apikey=APIgone
POST http://publicapi.test/v0/projects/p_1/keys bearer=st_1 project=p_1
