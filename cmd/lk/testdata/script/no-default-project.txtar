# With several projects, no default and no --project, a non-interactive run is
# a clear error, in API-key mode and under --user-auth.
! exec lk room list
cmp stderr want-api-key-stderr

! exec lk --user-auth project member list
cmp stderr want-user-auth-stderr

requests
! stdout .

-- home/.livekit/cli-config.yaml --
projects:
  - name: one
    project_id: p_1
    url: ws://one.test
    api_key: APIone
    api_secret: secretone
  - name: two
    project_id: p_2
    url: ws://two.test
    api_key: APItwo
    api_secret: secrettwo
default_user: u_1
users:
  - id: u_1
    email: dev@example.com
    session_token: st_1
    api_url: http://publicapi.test
    projects:
      - project_id: p_1
        name: one
        alias: one
      - project_id: p_2
        name: two
        alias: two
-- want-api-key-stderr --
multiple projects configured; set --project in non-interactive mode
-- want-user-auth-stderr --
Using user [dev@example.com] on [http://publicapi.test]
multiple projects available; set --project in non-interactive mode
