# While a session is active or has just ended, its agent can still upload its
# recording, and the Public API answers a recording that isn't there yet with
# no URL and a data status. lk fails and says when to read again, -o downloads
# nothing, and --json still prints the response for a script to read.
respond GET http://publicapi.test/v0/projects/p_1/sessions/RM_settling/recording-url 200 '{"url":"","dataStatus":{"state":"DATA_STATE_SETTLING","retryAfterSeconds":42}}'
! exec lk --user-auth analytics session recording RM_settling -o .
! stdout .
stderr '^session RM_settling has no audio recording yet, and its agent can still upload it: the session just ended — read again in 42s$'
! exists RM_settling-audio.ogg

! exec lk --user-auth analytics session recording RM_settling --json
cmp stdout want-settling-json
stderr '^session RM_settling has no audio recording yet, .* read again in 42s$'

# The API sends retryAfterSeconds 0 outside settling; --json passes it through.
respond GET http://publicapi.test/v0/projects/p_1/sessions/RM_active/recording-url 200 '{"url":"","dataStatus":{"state":"DATA_STATE_SESSION_ACTIVE","retryAfterSeconds":0}}'
! exec lk --user-auth analytics session recording RM_active --type chat-history -o .
! stdout .
stderr '^session RM_active has no chat history yet, and its agent can still upload it: the session is still active$'
! exists RM_active-chat-history.json

! exec lk --user-auth analytics session recording RM_active --type chat-history --json
cmp stdout want-active-json
stderr '^session RM_active has no chat history yet, .*: the session is still active$'

requests
cmp stdout want-requests

-- home/.livekit/cli-config.yaml --
default_user: u_1
users:
  - id: u_1
    email: dev@example.com
    session_token: st_1
    api_url: http://publicapi.test
    default_project: p_1
    projects:
      - project_id: p_1
        name: one
        alias: one
-- want-settling-json --
{
  "dataStatus": {
    "retryAfterSeconds": 42,
    "state": "DATA_STATE_SETTLING"
  },
  "url": ""
}
-- want-active-json --
{
  "dataStatus": {
    "retryAfterSeconds": 0,
    "state": "DATA_STATE_SESSION_ACTIVE"
  },
  "url": ""
}
-- want-requests --
GET http://publicapi.test/v0/projects/p_1/sessions/RM_settling/recording-url bearer=st_1 project=p_1
GET http://publicapi.test/v0/projects/p_1/sessions/RM_settling/recording-url bearer=st_1 project=p_1
GET http://publicapi.test/v0/projects/p_1/sessions/RM_active/recording-url bearer=st_1 project=p_1
GET http://publicapi.test/v0/projects/p_1/sessions/RM_active/recording-url bearer=st_1 project=p_1
