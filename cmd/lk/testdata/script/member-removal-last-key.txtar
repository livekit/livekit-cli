# A removal that would leave a project without an API key is refused even
# when the count is confirmed, so lk names the projects, counts the private
# ones, and makes no second call, even with --yes.
respond DELETE http://publicapi.test/v0/projects/p_1/members/u_2 400 '{"code":9, "message":"removing this member would delete the API keys they own (3 in total), including the last API key of \"one\", 1 private project(s); a project without an API key stops handling inbound SIP calls and webhooks, so have a member who is staying create a replacement API key first", "details":[{"@type":"type.googleapis.com/livekit.publicapi.common.v1.MemberRemovalNotConfirmed", "numKeys":3, "lastKeyProjectNames":["one"], "numPrivateLastKeyProjects":1}]}'
! exec lk --user-auth --yes project member remove u_2 --project one
! stdout .
stderr '^can''t remove u_2: it would delete the last API key of "one" and 1 private project\(s\); a project without an API key stops handling inbound SIP calls and webhooks, so have a member who is staying create a replacement API key there first$'
requests
cmp stdout want-requests

-- home/.livekit/cli-config.yaml --
default_user: u_admin
users:
  - id: u_admin
    email: admin@example.com
    session_token: st_admin
    api_url: http://publicapi.test
    projects:
      - project_id: p_1
        name: one
        alias: one
    workspaces:
      - workspace_id: ws_1
        name: acme
        alias: acme
-- want-requests --
DELETE http://publicapi.test/v0/projects/p_1/members/u_2 bearer=st_admin project=p_1
