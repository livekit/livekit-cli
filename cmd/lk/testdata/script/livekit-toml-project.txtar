# A livekit.toml in the working directory names the project by subdomain, and
# it wins over the default project.
respond POST http://one.test/twirp/livekit.RoomService/ListRooms 200 ''
respond POST http://two.test/twirp/livekit.RoomService/ListRooms 200 ''

exec lk room list
requests
cmp stdout want-requests

-- livekit.toml --
[project]
subdomain = "one"
-- home/.livekit/cli-config.yaml --
default_project: two
projects:
  - name: one
    project_id: p_1
    url: ws://one.test
    api_key: APIone
    api_secret: secretone
  - name: two
    project_id: p_2
    url: ws://two.test
    api_key: APItwo
    api_secret: secrettwo
-- want-requests --
POST http://one.test/twirp/livekit.RoomService/ListRooms apikey=APIone
