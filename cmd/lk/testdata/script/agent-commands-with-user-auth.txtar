# Under --user-auth, agent list and agent secrets call the Public API's
# AgentService. The other cloud agent commands, such as private-link list,
# call cloud agents with a token the Public API creates for the session (the
# token bridge), not an API key, until the Public API serves them.
env LK_AGENTS_URL=http://agents.test
mint st_1
respond GET http://publicapi.test/v0/projects/p_1/agents 200 '{"items":[]}'
exec lk --user-auth agent list
stderr 'No agents found'

respond GET http://publicapi.test/v0/projects/p_1/agents/CA_1/secrets 200 '{"items":[]}'
exec lk --user-auth agent secrets --id CA_1

respond POST http://agents.test/twirp/livekit.CloudAgent/ListPrivateLinks 200 ''
exec lk --user-auth agent private-link list
stderr 'No private links found'

requests
cmp stdout want-requests

-- home/.livekit/cli-config.yaml --
default_user: u_1
users:
  - id: u_1
    email: dev@example.com
    session_token: st_1
    api_url: http://publicapi.test
    projects:
      - project_id: p_1
        name: one
        alias: one
        url: ws://one.test
-- want-requests --
GET http://publicapi.test/v0/projects/p_1/agents bearer=st_1 project=p_1
GET http://publicapi.test/v0/projects/p_1/agents/CA_1/secrets bearer=st_1 project=p_1
POST http://publicapi.test/v0/projects/p_1/tokens bearer=st_1 project=p_1
POST http://agents.test/twirp/livekit.CloudAgent/ListPrivateLinks apikey=APImint_p_1
